redact_url() {
    python3 - "$1" <<'PYREDACT'
import sys
from urllib.parse import urlsplit, urlunsplit
value = sys.argv[1]
try:
    url = urlsplit(value)
    query = "<redacted>" if url.query else ""
    fragment = "<redacted>" if url.fragment else ""
    print(urlunsplit((url.scheme, url.netloc, url.path, query, fragment)))
except Exception:
    print("<url inválida>")
PYREDACT
}

redact_sensitive_text() {
    python3 - "$1" <<'PYREDACTTEXT'
import re, sys
from urllib.parse import urlsplit, urlunsplit
text = sys.argv[1]
def clean(match):
    raw = match.group(0)
    try:
        url = urlsplit(raw)
        return urlunsplit((url.scheme, url.netloc, url.path,
                           "<redacted>" if url.query else "",
                           "<redacted>" if url.fragment else ""))
    except Exception:
        return "<url inválida>"
print(re.sub(r'https?://[^\s<>]+', clean, text), end='')
PYREDACTTEXT
}

