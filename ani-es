provider_init() {
    case "${PROVIDER,,}" in
        animeav1|av1)
            PROVIDER="animeav1"
            BASE_URL="https://animeav1.com"
            ;;
        jkanime|jk)
            PROVIDER="jkanime"
            BASE_URL="https://jkanime.net"
            ;;
        *) die "Proveedor no soportado: $PROVIDER" ;;
    esac

    case "${LANGUAGE,,}" in
        sub|subs|subtitulado) LANGUAGE="sub" ;;
        dub|doblado) LANGUAGE="dub" ;;
        *) die "Idioma no soportado: $LANGUAGE. Usa sub o dub." ;;
    esac

    [[ "$HTTP_TIMEOUT" =~ ^[0-9]+$ && "$HTTP_TIMEOUT" -gt 0 ]] || die "ANI_ES_HTTP_TIMEOUT debe ser un entero positivo."
}

check_dependencies() {
    local missing=() command_name
    for command_name in curl fzf grep sed jq python3; do
        command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
    done

    local player="${ANI_ES_PLAYER:-mpv}"
    command -v "$player" >/dev/null 2>&1 || missing+=("$player")

    if ((${#missing[@]})); then
        die "Faltan dependencias: ${missing[*]}"
    fi
}

init_state() {
    mkdir -p -- "$STATE_DIR"
    [[ -f "$HISTORY_FILE" ]] || printf '{}\n' > "$HISTORY_FILE"

    if ! jq empty "$HISTORY_FILE" >/dev/null 2>&1; then
        local backup="$HISTORY_FILE.corrupt.$(date +%s)"
        mv -- "$HISTORY_FILE" "$backup"
        printf '{}\n' > "$HISTORY_FILE"
        warn "El historial estaba dañado. Se guardó en $backup"
    fi

    if [[ "$HISTORY_FILE" != "$LEGACY_JSON" && -f "$LEGACY_JSON" ]]; then
        local tmp
        tmp=$(mktemp "$STATE_DIR/history.XXXXXX") || die "No se pudo crear un temporal"
        if jq -s '.[0] * .[1]' "$HISTORY_FILE" "$LEGACY_JSON" > "$tmp"; then
            mv -- "$tmp" "$HISTORY_FILE"
            mv -- "$LEGACY_JSON" "$LEGACY_JSON.migrated"
            info "Historial JSON anterior importado."
        else
            rm -f -- "$tmp"
        fi
    fi

    [[ -f "$LEGACY_DB" ]] && migrate_legacy_db || true
}

migrate_legacy_db() {
    python3 - "$LEGACY_DB" "$HISTORY_FILE" <<'PY'
import json, sqlite3, sys
from pathlib import Path
legacy, target = map(Path, sys.argv[1:3])
try:
    data = json.loads(target.read_text(encoding="utf-8"))
except Exception:
    data = {}
with sqlite3.connect(legacy) as conn:
    if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='animes'").fetchone():
        raise SystemExit(1)
    for anime, ep, progress in conn.execute("SELECT anime,last_cap,progress FROM animes"):
        try: ep = int(ep)
        except Exception: ep = 1
        data[f"legacy:{anime}"] = {"title": anime, "url": "", "provider": "jkanime", "last_episode": ep, "progress": progress or "0"}
target.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
    mv -- "$LEGACY_DB" "$LEGACY_DB.migrated"
}

history_get_episode() { jq -r --arg key "$1" '.[$key].last_episode // empty' "$HISTORY_FILE"; }
history_get_progress() { jq -r --arg key "$1" '.[$key].progress // "0"' "$HISTORY_FILE"; }

history_save() {
    local key="$1" title="$2" url="$3" episode="$4" progress="$5"
    local tmp
    tmp=$(mktemp "$STATE_DIR/history.XXXXXX") || return 1
    if jq --arg key "$key" --arg title "$title" --arg url "$url" --arg provider "$PROVIDER" \
        --argjson episode "$episode" --arg progress "$progress" \
        '.[$key]={title:$title,url:$url,provider:$provider,last_episode:$episode,progress:$progress}' \
        "$HISTORY_FILE" > "$tmp"; then
        mv -- "$tmp" "$HISTORY_FILE"
    else
        rm -f -- "$tmp"
        warn "No se pudo guardar el historial."
    fi
}

