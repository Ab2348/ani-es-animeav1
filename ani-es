av1_parse_search_results() {
    local html_file="$1" payload_file="$WORKDIR/av1-search-payload.json"
    av1_extract_payload "$html_file" > "$payload_file"
    python3 - "$html_file" "$payload_file" "$BASE_URL" <<'PY'
import html, json, re, sys
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import urljoin, urlparse

html_file, payload_file, base = sys.argv[1:4]
page = Path(html_file).read_text(encoding="utf-8", errors="replace")
try:
    root = json.loads(Path(payload_file).read_text(encoding="utf-8"))
except Exception:
    root = {}

def walk(value):
    yield value
    if isinstance(value, dict):
        for child in value.values():
            yield from walk(child)
    elif isinstance(value, list):
        for child in value:
            yield from walk(child)

def normalize_result(item):
    if not isinstance(item, dict):
        return None
    title = item.get("title") or item.get("name")
    slug = item.get("slug")
    raw_url = item.get("url") or item.get("href") or (f"/media/{slug}" if slug else None)
    if not title or not raw_url:
        return None
    url = urljoin(base, str(raw_url))
    if not re.fullmatch(r"/media/[^/]+", urlparse(url).path.rstrip("/")):
        return None
    return url, html.unescape(str(title)).strip()

results = []
for value in walk(root):
    if not isinstance(value, list) or not value or len(value) > 500:
        continue
    candidates = [normalize_result(item) for item in value]
    candidates = [item for item in candidates if item]
    if candidates:
        results.extend(candidates)

class Parser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.current = None
        self.results = []
    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "a" and attrs.get("href"):
            href = attrs["href"]
            path = urlparse(urljoin(base, href)).path.rstrip("/")
            if re.fullmatch(r"/media/[^/]+", path):
                self.current = {"url": urljoin(base, href), "text": [], "alt": attrs.get("title", "")}
        elif self.current and tag == "img":
            self.current["alt"] = attrs.get("alt", self.current["alt"])
    def handle_data(self, data):
        if self.current:
            self.current["text"].append(data)
    def handle_endtag(self, tag):
        if tag == "a" and self.current:
            title = " ".join(" ".join(self.current["text"]).split()).strip()
            if not title:
                title = self.current["alt"].strip()
            title = re.sub(r"^(?:Portada|Póster|Poster|Backdrop)\s+(?:de\s+)?", "", title, flags=re.I)
            if title:
                self.results.append((self.current["url"], html.unescape(title)))
            self.current = None

parser = Parser()
parser.feed(page)
results.extend(parser.results)

seen = set()
for url, title in results:
    if url not in seen and title:
        seen.add(url)
        print(f"{url}\t{title}")
PY
}

av1_extract_payload() {
    python3 - "$1" <<'PY'
import ast, json, re, sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")

def balanced(src, start, op='[', cl=']'):
    depth = 0; quote = None; esc = False
    for i in range(start, len(src)):
        ch = src[i]
        if quote:
            if esc: esc = False
            elif ch == '\\': esc = True
            elif ch == quote: quote = None
            continue
        if ch in "'\"`": quote = ch; continue
        if ch == op: depth += 1
        elif ch == cl:
            depth -= 1
            if depth == 0: return src[start:i+1]
    return None

candidates = []
for pattern in (r"\b(?:const|let|var)\s+data\s*=", r"\bdata\s*:"):
    for m in re.finditer(pattern, text):
        start = text.find('[', m.end())
        if start != -1:
            expr = balanced(text, start)
            if expr: candidates.append(expr)

# Prioriza el payload de página sobre dependencias internas como data:["/auth"].
candidates.sort(key=lambda x: (
    sum(term in x for term in ("embeds", "downloads", "streamLinks", "episodes", "media", "variants")),
    len(x),
), reverse=True)

def parse(expr):
    try: return json.loads(expr)
    except Exception: pass
    cleaned = re.sub(r'([{,]\s*)([A-Za-z_$][\w$]*)(\s*:)', r'\1"\2"\3', expr)
    # SvelteKit serializa valores ausentes como `void 0`.
    cleaned = re.sub(r'\bvoid\s+0\b|\bundefined\b|\bNaN\b', 'None', cleaned)
    cleaned = re.sub(r'\bnull\b', 'None', cleaned)
    cleaned = re.sub(r'\btrue\b', 'True', cleaned)
    cleaned = re.sub(r'\bfalse\b', 'False', cleaned)
    try: return ast.literal_eval(cleaned)
    except Exception: return None

for expr in candidates:
    value = parse(expr)
    if isinstance(value, (list, dict)):
        print(json.dumps(value, ensure_ascii=False))
        raise SystemExit(0)
print('{}')
PY
}

av1_parse_metadata() {
    local html_file="$1" payload_file="$WORKDIR/av1-payload.json"
    av1_extract_payload "$html_file" > "$payload_file"
    python3 - "$html_file" "$payload_file" "$BASE_URL" <<'PY'
import json, re, sys
from pathlib import Path
from urllib.parse import urljoin, urlparse

html = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
try: root = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
except Exception: root = {}
base = sys.argv[3]

def walk(v):
    yield v
    if isinstance(v, dict):
        for x in v.values(): yield from walk(x)
    elif isinstance(v, list):
        for x in v: yield from walk(x)

best = None; score = -1
for obj in walk(root):
    if not isinstance(obj, dict): continue
    s = 0
    if isinstance(obj.get("title"), str): s += 3
    if isinstance(obj.get("episodes"), list): s += 5
    if obj.get("totalEpisodes") is not None: s += 3
    if obj.get("slug"): s += 1
    if s > score: best, score = obj, s
best = best or {}

episodes = []
for key in ("episodes", "episodeList"):
    val = best.get(key)
    if isinstance(val, list):
        for idx, ep in enumerate(val, 1):
            if not isinstance(ep, dict): continue
            n = ep.get("number", ep.get("episode", ep.get("ep", ep.get("order", idx))))
            try: n = int(n)
            except Exception: continue
            url = ep.get("url") or ep.get("href") or ep.get("link")
            if url: url = urljoin(base, str(url))
            episodes.append((n, url or ""))

# Fallback HTML: enlaces visibles de episodios.
for href, num in re.findall(r'href=["\'](/media/[^/"\']+/(\d+))/?["\']', html, re.I):
    episodes.append((int(num), urljoin(base, href)))

unique = {}
for n, url in episodes: unique[n] = url

# Algunas películas de AnimeAV1 se publican como un único episodio número 0.
# El selector humano sigue mostrando 1, pero conserva la ruta real terminada en /0.
if len(unique) == 1 and 0 in unique:
    unique = {1: unique[0]}

total = best.get("totalEpisodes") or best.get("total_episodes") or best.get("episodesCount")
try: total = int(total)
except Exception: total = max(unique, default=0)

type_value = best.get("type")
if isinstance(best.get("category"), dict): type_value = best["category"].get("name", type_value)
print(json.dumps({"title": best.get("title", ""), "type": type_value or "", "total": total, "episodes": unique}, ensure_ascii=False))
PY
}

av1_parse_episode_links() {
    local html_file="$1" payload_file="$WORKDIR/av1-episode-payload.json"
    av1_extract_payload "$html_file" > "$payload_file"
    python3 - "$html_file" "$payload_file" "$BASE_URL" <<'PY'
import html as htmllib, json, re, sys
from pathlib import Path
from urllib.parse import urljoin, urlparse

html = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
try: root = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
except Exception: root = {}
base = sys.argv[3]

def walk(v):
    yield v
    if isinstance(v, dict):
        for x in v.values(): yield from walk(x)
    elif isinstance(v, list):
        for x in v: yield from walk(x)

def normalize(entry, name=""):
    if isinstance(entry, str): url = entry; quality = ""
    elif isinstance(entry, dict):
        url = next((entry.get(k) for k in ("url","href","link","embed","streamUrl","downloadUrl","file","source") if entry.get(k)), None)
        name = entry.get("server") or entry.get("name") or entry.get("provider") or entry.get("host") or name
        quality = entry.get("quality") or entry.get("resolution") or entry.get("label") or ""
    else: return None
    if not url: return None
    url = urljoin(base, htmllib.unescape(str(url)).replace('\\/', '/'))
    if not name:
        name = urlparse(url).hostname or "desconocido"
    return str(name), url, str(quality)

def emit_container(container, kind):
    if not isinstance(container, dict): return
    for variant_key, value in container.items():
        language = str(variant_key).lower()
        if language not in ("sub", "dub"): continue
        if isinstance(value, list):
            for e in value:
                item = normalize(e)
                if item: yield language, kind, *item
        elif isinstance(value, dict):
            for child_name, child in value.items():
                child_kind = "download" if "download" in child_name.lower() else kind
                vals = child if isinstance(child, list) else [child]
                for e in vals:
                    item = normalize(e, child_name)
                    if item: yield language, child_kind, *item
        else:
            item = normalize(value)
            if item: yield language, kind, *item

rows = []
for obj in walk(root):
    if not isinstance(obj, dict): continue
    for key, kind in (("streamLinks","stream"),("downloadLinks","download"),("servers","stream"),
                      ("embeds","stream"),("downloads","download")):
        if key in obj: rows.extend(emit_container(obj[key], kind) or [])
    if any(str(k).lower() in ("sub", "dub") for k in obj):
        rows.extend(emit_container(obj, "stream") or [])

# Fallback de URLs conocidas incrustadas directamente en el HTML.
if not rows:
    pattern = r'https?://[^\s"\'<>]+(?:pixeldrain|pdrain|mp4upload|mega\.nz|uns\.bio|upnshare|zilla|\.m3u8)[^\s"\'<>]*'
    for url in re.findall(pattern, html, re.I):
        rows.append(("sub", "stream", urlparse(url).hostname or "desconocido", htmllib.unescape(url), ""))

seen = set()
for row in rows:
    # Un mismo contenedor SUB/DUB se vuelve a visitar durante el recorrido.
    # Conserva la primera clasificación (embed antes que descarga) por URL.
    key = (row[0], row[3])
    if key in seen: continue
    seen.add(key)
    print("\t".join(str(x).replace("\t", " ") for x in row))
PY
}

choose_from_results() {
    local results="$1" prompt="$2" choice
    [[ -n "$results" ]] || return 1
    choice=$(printf '%s\n' "$results" | fzf --delimiter=$'\t' --with-nth=2 --prompt="$prompt" --height=~24 --border --reverse) || return 1
    printf '%s\n' "$choice"
}

av1_search_anime() {
    local query="$1" encoded html_file results key
    encoded=$(urlencode_query "$query")
    html_file="$WORKDIR/search.html"
    for key in search q; do
        info "Buscando ‘$query’ en AnimeAV1..."
        if http_get "$BASE_URL/catalogo?$key=$encoded" > "$html_file"; then
            results=$(av1_parse_search_results "$html_file")
            [[ -n "$results" ]] && { choose_from_results "$results" "Selecciona un anime: "; return; }
        fi
    done
    return 1
}

av1_get_episode_metadata() {
    local anime_url="$1" html_file metadata
    html_file="$WORKDIR/anime.html"
    http_get "$anime_url" > "$html_file" || return 1
    metadata=$(av1_parse_metadata "$html_file") || return 1
    EPISODE_TOTAL=$(jq -r '.total // 0' <<<"$metadata")
    ANIME_TYPE=$(jq -r '.type // ""' <<<"$metadata")
    EPISODE_MAP_FILE="$WORKDIR/episode-map.tsv"
    jq -r '.episodes // {} | to_entries[] | "\(.key)\t\(.value)"' <<<"$metadata" > "$EPISODE_MAP_FILE"
    [[ "$EPISODE_TOTAL" =~ ^[0-9]+$ && "$EPISODE_TOTAL" -gt 0 ]]
}

server_token() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]'
}

server_rank() {
    case "$(server_token "$1")" in
        *pdrain*|*pixeldrain*) echo 10 ;;
        *hls*|*zilla*) echo 20 ;;
        *upnshare*|*unsbio*) echo 30 ;;
        *mp4upload*) echo 40 ;;
        *yourupload*) echo 50 ;;
        *streamtape*) echo 60 ;;
        *mega*) echo 90 ;;
        *) echo 70 ;;
    esac
}

media_url_is_plausible() {
    local url="${1,,}"
    case "$url" in
        *.js|*.js\?*|*.css|*.css\?*|*.html|*.html\?*|*.htm|*.htm\?*|*.json|*.json\?*|*.png|*.jpg|*.jpeg|*.gif|*.svg|*.webp|*.woff|*.woff2|*.ttf)
            return 1
            ;;
        *.m3u8|*.m3u8\?*|*.mp4|*.mp4\?*|*.mkv|*.mkv\?*|*.webm|*.webm\?*|*/api/file/*)
            return 0
            ;;
    esac
    return 1
}

