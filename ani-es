absolute_url() {
    local value="$1" base="${2:-$BASE_URL}"
    case "$value" in
        http://*|https://*) printf '%s\n' "$value" ;;
        //*) printf 'https:%s\n' "$value" ;;
        /*) printf '%s%s\n' "$base" "$value" ;;
        *) printf '%s/%s\n' "${base%/}" "$value" ;;
    esac
}

http_get() {
    local url="$1" referer="${2:-}"
    case "$url" in http://*|https://*) ;; *) return 1 ;; esac
    local args=(--fail --silent --show-error --location
        --proto '=http,https' --proto-redir '=http,https'
        --connect-timeout 15 --max-time "$HTTP_TIMEOUT" --retry 2 --retry-delay 1
        --user-agent "$USER_AGENT")
    [[ -n "$referer" ]] && args+=(--referer "$referer")
    curl "${args[@]}" -- "$url"
}

