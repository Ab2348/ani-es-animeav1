normalize_playback_position() {
    local value="$1"
    awk -F: '
        NF == 3 {seconds=($1 * 3600) + ($2 * 60) + $3}
        NF == 2 {seconds=($1 * 60) + $2}
        NF == 1 {seconds=$1}
        END {
            if (seconds == "") exit 1
            printf "%.3f\n", seconds
        }
    ' <<<"$value" | sed -E 's/([.]0+)$//; s/([.][0-9]*[1-9])0+$/\1/'
}

play_episode() {
    local title="$1" anime_url="$2" episode="$3" start="$4"
    local episode_url player output_file output="" position player_status resolve_status
    local server video_url media_referer media_origin media_type success=0 candidate_count=0
    episode_url=$(provider_episode_url "$anime_url" "$episode")
    info "Resolviendo episodio $episode ($LANGUAGE)..."
    debug "anime_url=$(redact_url "$anime_url")"
    debug "episode_url=$(redact_url "$episode_url")"
    debug "language=$LANGUAGE"

    player="${ANI_ES_PLAYER:-mpv}"
    local extra_flags=()
    [[ -n "${ANI_ES_PLAYER_FLAGS:-}" ]] && read -r -a extra_flags <<<"$ANI_ES_PLAYER_FLAGS"
    output_file="$WORKDIR/player-output.txt"
    RESOLVE_STATUS_FILE="$WORKDIR/resolve-status"
    RESOLVE_FAILURES_FILE="$WORKDIR/resolve-failures.tsv"
    rm -f -- "$RESOLVE_STATUS_FILE" "$RESOLVE_FAILURES_FILE"

    while IFS=$'\t' read -r server video_url media_referer media_origin media_type; do
        [[ -n "$video_url" ]] || continue
        ((candidate_count += 1))
        [[ -n "$media_type" ]] || media_type=$(media_type_for_url "$video_url")
        info "Validando servidor $server..."
        debug "candidato elegido=$server tipo=$media_type URL=$(redact_url "$video_url")"
        debug "Referer=$(redact_url "${media_referer:-$episode_url}")"
        debug "Origin=${media_origin:-ninguno}"

        if ! probe_media_url "$video_url" "${media_referer:-$episode_url}" "$media_origin" "$media_type"; then
            warn "$server descartado: $PROBE_REASON."
            printf '%s\t%s\n' "$server" "$PROBE_REASON" >> "$RESOLVE_FAILURES_FILE"
            continue
        fi

        info "Probando servidor $server..."
        : > "$output_file"

        local header_flags=(--user-agent="$USER_AGENT" --referrer="${media_referer:-$episode_url}")
        if [[ -n "$media_origin" ]]; then
            header_flags+=(--http-header-fields="Origin: $media_origin")
        fi

        local statuses=()
        if "$player" --no-ytdl --start="${start:-0}" \
            --force-media-title="$title — episodio $episode" \
            --term-status-msg='ANI_ES_TIME=${playback-time}' \
            "${header_flags[@]}" "${extra_flags[@]}" "$video_url" \
            2>&1 | tr '\r' '\n' > "$output_file"; then
            statuses=("${PIPESTATUS[@]}")
        else
            statuses=("${PIPESTATUS[@]}")
        fi
        player_status=${statuses[0]}
        output=$(cat -- "$output_file")
        debug "mpv terminó con código $player_status"
        if [[ "$DEBUG" == "1" && -n "$output" ]]; then
            printf '%s\n' "$(redact_sensitive_text "$output")" >&2
        fi
        position=$(sed -nE 's/.*ANI_ES_TIME=([0-9:.]+).*/\1/p' <<<"$output" | tail -n1)
        [[ -n "$position" ]] && position=$(normalize_playback_position "$position" || true)
        [[ -n "$position" ]] && LAST_POSITION="$position"

        if ((player_status == 0)); then
            success=1
            break
        fi

        if ((player_status == 130 || player_status == 143)); then
            [[ "$DEBUG" == "1" ]] || printf '%s\n' "$(redact_sensitive_text "$output")" >&2
            return "$player_status"
        fi

        warn "$server falló con código $player_status; probando otra fuente."
        printf '%s\tmpv terminó con código %s\n' "$server" "$player_status" >> "$RESOLVE_FAILURES_FILE"
    done < <(provider_resolve_video_candidates "$episode_url")

    if ((success == 0)); then
        resolve_status=$(cat "$RESOLVE_STATUS_FILE" 2>/dev/null || printf 'NO_RESOLVED')
        if [[ "$resolve_status" == "NO_VARIANT" ]]; then
            if [[ "$LANGUAGE" == "dub" ]]; then
                warn "El episodio $episode no tiene versión doblada disponible en AnimeAV1."
            else
                warn "El episodio $episode no tiene versión subtitulada disponible en AnimeAV1."
            fi
            return 3
        fi

        warn "No se pudo reproducir el episodio $episode."
        if [[ -s "$RESOLVE_FAILURES_FILE" ]]; then
            awk -F '\t' '!seen[$0]++ {printf "- %s: %s\n", $1, $2}' "$RESOLVE_FAILURES_FILE" >&2
        elif ((candidate_count == 0)); then
            printf '%s\n' '- AnimeAV1: no devolvió candidatos resolubles.' >&2
        fi
        return 4
    fi
    return 0
}

choose_episode() {
    local total="$1"
    seq 1 "$total" | fzf --prompt="Episodio: " --height=~30 --border --reverse
}

update_self() {
    local update_url="${ANI_ES_UPDATE_URL:-}" expected_sha="${ANI_ES_UPDATE_SHA256:-}" target tmp actual_sha
    [[ -n "$update_url" ]] || die "Define ANI_ES_UPDATE_URL antes de usar --update."
    [[ "$expected_sha" =~ ^[A-Fa-f0-9]{64}$ ]] || die "Define ANI_ES_UPDATE_SHA256 con el SHA-256 publicado de la versión."
    python3 - "$update_url" <<'PYUPDATEURL' || die "ANI_ES_UPDATE_URL debe ser una URL HTTPS sin credenciales incrustadas."
import sys
from urllib.parse import urlsplit
url = urlsplit(sys.argv[1])
if url.scheme != "https" or not url.hostname or url.username or url.password:
    raise SystemExit(1)
PYUPDATEURL
    target=$(python3 - "$0" <<'PYTARGET'
from pathlib import Path
import sys
print(Path(sys.argv[1]).resolve())
PYTARGET
)
    [[ -w "$target" ]] || die "No se puede escribir $target. Instálalo en ~/.local/bin."
    tmp=$(mktemp "${target}.update.XXXXXX") || die "No se pudo crear el temporal."
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
        --max-filesize 1048576 --output "$tmp" -- "$update_url" || { rm -f "$tmp"; die "Falló la descarga."; }
    actual_sha=$(python3 - "$tmp" <<'PYSHAFILE'
import hashlib, sys
with open(sys.argv[1], "rb") as source:
    digest = hashlib.sha256()
    for chunk in iter(lambda: source.read(1024 * 1024), b""):
        digest.update(chunk)
print(digest.hexdigest())
PYSHAFILE
)
    [[ "${actual_sha,,}" == "${expected_sha,,}" ]] || { rm -f -- "$tmp"; die "El SHA-256 de la actualización no coincide."; }
    grep -q '^#!/usr/bin/env bash' "$tmp" && grep -q '^VERSION=' "$tmp" \
        && grep -Fq 'ANI_ES_PROJECT="ani-es-animeav1"' "$tmp" && bash -n "$tmp" \
        || { rm -f "$tmp"; die "Actualización inválida."; }
    chmod 0755 "$tmp"
    mv -- "$tmp" "$target"
    info "ani-es actualizado y verificado."
}

main() {
    while (($#)); do
        case "$1" in
            -c|--continue) CONTINUE=1 ;;
            -p|--provider) [[ $# -ge 2 ]] || die "Falta proveedor"; PROVIDER="$2"; shift ;;
            --sub) LANGUAGE="sub" ;;
            --dub) LANGUAGE="dub" ;;
            --server) [[ $# -ge 2 ]] || die "Falta servidor"; PREFERRED_SERVER="$2"; shift ;;
            --debug) DEBUG=1 ;;
            --keep-workdir) KEEP_WORKDIR=1 ;;
            -u|--update) update_self; exit 0 ;;
            -v|--version) provider_init; show_version; exit 0 ;;
            -h|--help) show_help; exit 0 ;;
            --) shift; QUERY="$*"; break ;;
            -*) die "Opción desconocida: $1" ;;
            *) QUERY+="${QUERY:+ }$1" ;;
        esac
        shift
    done

    provider_init
    check_dependencies
    init_state
    WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/ani-es.XXXXXX") || die "No se pudo crear el directorio temporal."

    if [[ -z "$QUERY" ]]; then read -r -p "Buscar anime: " QUERY; fi
    [[ -n "$QUERY" ]] || die "La búsqueda está vacía."

    local selection anime_url anime_title history_key total episode progress option
    selection=$(provider_search_anime "$QUERY") || die "No se encontraron resultados en $PROVIDER."
    anime_url=${selection%%$'\t'*}; anime_title=${selection#*$'\t'}
    debug "anime_url=$(redact_url "$anime_url")"
    history_key="$PROVIDER:$LANGUAGE:$anime_url"

    provider_get_episode_metadata "$anime_url" || die "No se pudo obtener el listado de episodios de $anime_url"
    total="$EPISODE_TOTAL"
    info "$anime_title — $total episodio(s) — $PROVIDER/$LANGUAGE"

    if ((CONTINUE)); then
        episode=$(history_get_episode "$history_key"); progress=$(history_get_progress "$history_key")
        if [[ ! "$episode" =~ ^[0-9]+$ || "$episode" -lt 1 || "$episode" -gt "$total" ]]; then
            warn "No existe progreso válido; selecciona un episodio."
            episode=$(choose_episode "$total") || exit 0; progress=0
        fi
    else
        episode=$(choose_episode "$total") || exit 0; progress=0
    fi

    while :; do
        LAST_POSITION=0
        if play_episode "$anime_title" "$anime_url" "$episode" "$progress"; then
            :
        else
            local play_status=$?
            debug "play_episode terminó con estado $play_status"
            warn "Volviendo al selector de episodios."
            episode=$(choose_episode "$total") || exit 0
            progress=0
            continue
        fi
        history_save "$history_key" "$anime_title" "$anime_url" "$episode" "$LAST_POSITION"
        option=$(printf '%s\n' "Siguiente" "Anterior" "Repetir" "Volver a episodios" "Salir" | fzf --prompt="Después del episodio $episode: " --height=9 --border --reverse) || exit 0
        case "$option" in
            Siguiente) ((episode < total)) && { ((episode++)); progress=0; } || warn "Último episodio." ;;
            Anterior) ((episode > 1)) && { ((episode--)); progress=0; } || warn "Primer episodio." ;;
            Repetir) progress=0 ;;
            "Volver a episodios") episode=$(choose_episode "$total") || exit 0; progress=0 ;;
            *) exit 0 ;;
        esac
    done
}

if [[ "${ANI_ES_SOURCE_ONLY:-0}" != "1" ]]; then
    main "$@"
fi
