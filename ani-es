# Salida de todos los resolutores: URL<TAB>Referer<TAB>Origin<TAB>Tipo
resolve_zilla() {
    local candidate="$1" id origin
    origin=$(url_origin "$candidate")
    if [[ "$candidate" =~ ^https?://player\.zilla-networks\.com/play/([^/?#]+) ]]; then
        id="${BASH_REMATCH[1]}"
        printf '%s\t%s\t%s\thls\n' "$origin/m3u8/$id" "$candidate" "$origin"
        return 0
    fi
    if [[ "$candidate" =~ ^https?://player\.zilla-networks\.com/m3u8/([^/?#]+) ]]; then
        printf '%s\t%s\t%s\thls\n' "$candidate" "$candidate" "$origin"
        return 0
    fi
    return 1
}

resolve_pixeldrain() {
    local candidate="$1" id
    [[ "$candidate" =~ pixeldrain\.com/(u|l)/([A-Za-z0-9]+) ]] || return 1
    id="${BASH_REMATCH[2]}"
    printf 'https://pixeldrain.com/api/file/%s?download\t%s\t%s\tfile\n' "$id" "$candidate" "https://pixeldrain.com"
}

media_type_for_url() {
    case "${1,,}" in
        *.m3u8|*.m3u8\?*) printf 'hls\n' ;;
        *) printf 'file\n' ;;
    esac
}

resolve_generic_embed() {
    local candidate="$1" referer="$2" page_file direct media_type
    case "$candidate" in http://*|https://*) ;; *) return 1 ;; esac
    page_file="$WORKDIR/embed-$(cache_key "$candidate").html"
    if http_get "$candidate" "$referer" > "$page_file" 2>/dev/null; then
        direct=$(python3 - "$page_file" <<'PYRESOLVE'
import html, re, sys
text=open(sys.argv[1],encoding='utf-8',errors='replace').read()
patterns=[
 r'https?://[^\s"\'<>]+\.m3u8(?:\?[^\s"\'<>]*)?(?=[\s"\'<>]|$)',
 r'https?://[^\s"\'<>]+\.(?:mp4|mkv|webm)(?:\?[^\s"\'<>]*)?(?=[\s"\'<>]|$)',
 r'(?:file|src|source)\s*[:=]\s*["\']([^"\']+\.(?:m3u8|mp4|mkv|webm)(?:\?[^"\']*)?)["\']',
]
for p in patterns:
    m=re.search(p,text,re.I)
    if m:
        print(html.unescape(m.group(1) if m.lastindex else m.group(0)).replace('\\/','/'))
        break
PYRESOLVE
) || true
        if [[ -n "$direct" ]]; then
            direct=$(absolute_url "$direct" "$candidate")
            if media_url_is_plausible "$direct"; then
                media_type=$(media_type_for_url "$direct")
                printf '%s\t%s\t%s\t%s\n' "$direct" "$candidate" "$(url_origin "$candidate")" "$media_type"
                return 0
            fi
        fi
    fi

    if command -v yt-dlp >/dev/null 2>&1; then
        while IFS= read -r direct; do
            [[ -n "$direct" ]] || continue
            if media_url_is_plausible "$direct"; then
                media_type=$(media_type_for_url "$direct")
                printf '%s\t%s\t%s\t%s\n' "$direct" "$candidate" "$(url_origin "$candidate")" "$media_type"
                return 0
            fi
        done < <(yt-dlp --no-warnings --no-playlist --referer "$referer" --get-url "$candidate" 2>/dev/null || true)
    fi

    return 1
}

resolve_candidate_url() {
    local candidate="$1" referer="$2" media_type
    case "${candidate,,}" in
        *player.zilla-networks.com/play/*|*player.zilla-networks.com/m3u8/*)
            resolve_zilla "$candidate"; return ;;
        *pixeldrain.com/u/*|*pixeldrain.com/l/*)
            resolve_pixeldrain "$candidate"; return ;;
    esac
    if media_url_is_plausible "$candidate"; then
        media_type=$(media_type_for_url "$candidate")
        printf '%s\t%s\t%s\t%s\n' "$candidate" "$referer" "$(url_origin "$candidate")" "$media_type"
        return 0
    fi
    resolve_generic_embed "$candidate" "$referer"
}

probe_request() {
    local media_type="$1" url="$2" referer="$3" origin="$4"
    local key body_file headers_file curl_error_file result curl_status http_status content_type
    case "$url" in
        http://*|https://*) ;;
        *) PROBE_REASON="protocolo no permitido"; return 1 ;;
    esac
    key=$(cache_key "$url")
    body_file="$WORKDIR/probe-$key.body"
    headers_file="$WORKDIR/probe-$key.headers"
    curl_error_file="$WORKDIR/probe-$key.curl-error"
    local args=(--silent --show-error --location
        --proto '=http,https' --proto-redir '=http,https'
        --connect-timeout 15 --max-time "$HTTP_TIMEOUT"
        --range 0-1023 --max-filesize 262144 --user-agent "$USER_AGENT"
        --referer "${referer:-$url}" --dump-header "$headers_file" --output "$body_file"
        --write-out $'%{http_code}\t%{content_type}')
    [[ -n "$origin" ]] && args+=(--header "Origin: $origin")

    result=$(curl "${args[@]}" -- "$url" 2> "$curl_error_file") && curl_status=0 || curl_status=$?
    IFS=$'\t' read -r http_status content_type <<<"$result"
    PROBE_HTTP_STATUS="${http_status:-000}"
    PROBE_CONTENT_TYPE="${content_type:-desconocido}"
    debug "probe tipo=$media_type HTTP=$PROBE_HTTP_STATUS Content-Type=$PROBE_CONTENT_TYPE curl=$curl_status"
    if [[ "$DEBUG" == "1" && -s "$curl_error_file" ]]; then
        debug "curl: $(redact_sensitive_text "$(cat "$curl_error_file")")"
    fi

    if ((curl_status != 0)); then
        PROBE_REASON="curl falló con código $curl_status"; return 1
    fi
    if [[ "$PROBE_HTTP_STATUS" != "200" && "$PROBE_HTTP_STATUS" != "206" ]]; then
        PROBE_REASON="HTTP $PROBE_HTTP_STATUS"; return 1
    fi
    if [[ "$media_type" == "hls" ]]; then
        if [[ "${PROBE_CONTENT_TYPE,,}" =~ (text/html|application/json|javascript|text/css) ]]; then
            PROBE_REASON="Content-Type incompatible: $PROBE_CONTENT_TYPE"; return 1
        fi
        if ! grep -aFq '#EXTM3U' "$body_file"; then
            PROBE_REASON="la respuesta no es un manifiesto HLS (#EXTM3U ausente)"; return 1
        fi
        if [[ "$DEBUG" == "1" ]]; then
            debug "manifiesto: $(grep -a '^#' "$body_file" | head -n 4 | tr '\n' ' ')"
        fi
    else
        if [[ ! "${PROBE_CONTENT_TYPE,,}" =~ ^(video/|audio/|application/octet-stream|binary/octet-stream) ]]; then
            if ! python3 - "$body_file" <<'PYMAGIC'
import sys
p=open(sys.argv[1], 'rb').read(64)
raise SystemExit(0 if (b'ftyp' in p[:32] or p.startswith(b'\x1aE\xdf\xa3')) else 1)
PYMAGIC
            then
                PROBE_REASON="Content-Type no multimedia: $PROBE_CONTENT_TYPE"; return 1
            fi
        fi
    fi
    PROBE_REASON="válido"
    return 0
}

probe_hls_url() { probe_request hls "$1" "$2" "$3"; }
probe_direct_media_url() { probe_request file "$1" "$2" "$3"; }
probe_media_url() {
    case "$4" in
        hls) probe_hls_url "$1" "$2" "$3" ;;
        file) probe_direct_media_url "$1" "$2" "$3" ;;
        *) PROBE_REASON="tipo de medio desconocido: $4"; return 1 ;;
    esac
}

server_matches_request() {
    local requested="$1" token="$2"
    [[ -z "$requested" || "$requested" == "auto" ]] && return 0
    case "$requested" in
        hls|zilla) [[ "$token" == *hls* || "$token" == *zilla* ]] ;;
        pdrain|pixeldrain) [[ "$token" == *pdrain* || "$token" == *pixeldrain* ]] ;;
        upnshare|unsbio) [[ "$token" == *upnshare* || "$token" == *unsbio* ]] ;;
        *) [[ "$token" == *"$requested"* ]] ;;
    esac
}

# Devuelve todos los candidatos resolubles, en orden de preferencia.
av1_resolve_video_candidates() {
    local episode_url="$1" html_file links_file candidates language kind server url quality token requested rank resolved
    local language_count=0 filtered_count=0 resolved_count=0 available_servers="" available_server_keys=","
    html_file="$WORKDIR/episode.html"
    links_file="$WORKDIR/episode-links.tsv"
    RESOLVE_STATUS_FILE="${RESOLVE_STATUS_FILE:-$WORKDIR/resolve-status}"
    RESOLVE_FAILURES_FILE="${RESOLVE_FAILURES_FILE:-$WORKDIR/resolve-failures.tsv}"
    : > "$RESOLVE_FAILURES_FILE"
    printf 'FETCH_FAILED\n' > "$RESOLVE_STATUS_FILE"
    debug "episode_url=$(redact_url "$episode_url")"
    debug "language=$LANGUAGE server=$PREFERRED_SERVER"
    http_get "$episode_url" > "$html_file" || {
        printf 'AnimeAV1\tno se pudo descargar la página del episodio\n' >> "$RESOLVE_FAILURES_FILE"
        return 1
    }
    av1_parse_episode_links "$html_file" > "$links_file"
    if [[ ! -s "$links_file" ]]; then
        printf 'NO_LINKS\n' > "$RESOLVE_STATUS_FILE"
        printf 'AnimeAV1\tla página no contiene enlaces reconocibles\n' >> "$RESOLVE_FAILURES_FILE"
        return 1
    fi

    if [[ "$DEBUG" == "1" ]]; then
        while IFS=$'\t' read -r language kind server url quality; do
            debug "enlace: $language $kind $server $(redact_url "$url") ${quality:+calidad=$quality}"
        done < "$links_file"
    fi

    requested=$(server_token "$PREFERRED_SERVER")
    candidates="$WORKDIR/candidates.tsv"
    : > "$candidates"
    while IFS=$'\t' read -r language kind server url quality; do
        [[ "$language" == "$LANGUAGE" ]] || continue
        ((language_count += 1))
        if [[ "$available_server_keys" != *",$server,"* ]]; then
            available_servers+="${available_servers:+, }$server"
            available_server_keys+="$server,"
        fi
        token=$(server_token "$server $url")
        if ! server_matches_request "$requested" "$token"; then
            continue
        fi
        ((filtered_count += 1))
        rank=$(server_rank "$server $url")
        [[ "$kind" == "download" ]] && rank=$((rank + 5))
        printf '%03d\t%s\t%s\t%s\n' "$rank" "$server" "$kind" "$url" >> "$candidates"
    done < "$links_file"

    if ((language_count == 0)); then
        printf 'NO_VARIANT\n' > "$RESOLVE_STATUS_FILE"
        return 1
    fi
    if ((filtered_count == 0)); then
        printf 'NO_SERVER_MATCH\n' > "$RESOLVE_STATUS_FILE"
        printf '%s\tno está disponible para %s; servidores detectados: %s\n' "$PREFERRED_SERVER" "$LANGUAGE" "${available_servers:-ninguno}" >> "$RESOLVE_FAILURES_FILE"
        return 1
    fi

    while IFS=$'\t' read -r _rank server kind url; do
        debug "candidato: $server/$kind $(redact_url "$url")"
        resolved=$(resolve_candidate_url "$url" "$episode_url") || true
        if [[ -z "$resolved" ]]; then
            printf '%s\tno se encontró una URL multimedia directa\n' "$server" >> "$RESOLVE_FAILURES_FILE"
            continue
        fi
        ((resolved_count += 1))
        debug "transformado: $server $(redact_url "${resolved%%$'\t'*}")"
        printf '%s\t%s\n' "$server" "$resolved"
    done < <(sort -n "$candidates")
    if ((resolved_count > 0)); then
        printf 'READY\n' > "$RESOLVE_STATUS_FILE"
    else
        printf 'NO_RESOLVED\n' > "$RESOLVE_STATUS_FILE"
    fi
}


